# Qt colors (a KDE color scheme), a pywal16 template. wal renders it to
# ~/.cache/wal/qtengine.colors, which the qtengine package's config.json selects; Qt apps
# read it when they start. Only background, foreground and color0-15 are used, so a
# wallpaper scheme fits as well as the committed Wisteria Dusk one.
# Surfaces are the background lightened: mantle 3, base 5, surface0 9, surface1 14,
# surface2 20. Selection colors are the slot darkened 70.

[ColorEffects:Disabled]
Color={background.lighten(5)}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={background}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=true
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={background.lighten(20)}
BackgroundNormal={background.lighten(9)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={foreground}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:Complementary]
BackgroundAlternate={background}
BackgroundNormal={background.lighten(5)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={color7}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:Header]
BackgroundAlternate={background.lighten(5)}
BackgroundNormal={background.lighten(5)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={color7}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:Header][Inactive]
BackgroundAlternate={background.lighten(5)}
BackgroundNormal={background.lighten(5)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={color7}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:Selection]
BackgroundAlternate={color5}
BackgroundNormal={color5}
DecorationFocus={color5}
DecorationHover={color4}
ForegroundActive={background.lighten(5)}
ForegroundInactive={background.lighten(5)}
ForegroundLink={color4.darken(70)}
ForegroundNegative={color1.darken(70)}
ForegroundNeutral={color3.darken(70)}
ForegroundNormal={background.lighten(5)}
ForegroundPositive={color2.darken(70)}
ForegroundVisited={color5.darken(70)}

[Colors:Tooltip]
BackgroundAlternate={background.lighten(20)}
BackgroundNormal={background.lighten(5)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={foreground}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:View]
BackgroundAlternate={background.lighten(5)}
BackgroundNormal={background}
DecorationFocus={color5}
DecorationHover={color5.darken(40)}
ForegroundActive={foreground}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={foreground}
ForegroundPositive={color2}
ForegroundVisited={color5}

[Colors:Window]
BackgroundAlternate={background.lighten(20)}
BackgroundNormal={background.lighten(5)}
DecorationFocus={color5}
DecorationHover={color5}
ForegroundActive={color4}
ForegroundInactive={color8.lighten(15)}
ForegroundLink={color4}
ForegroundNegative={color1}
ForegroundNeutral={color3}
ForegroundNormal={color7}
ForegroundPositive={color2}
ForegroundVisited={color5}

[General]
ColorScheme=Wal
Name=Wal
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={background.lighten(14)}
activeBlend=252,252,252
activeForeground={foreground}
inactiveBackground={background.lighten(14)}
inactiveBlend=161,169,177
inactiveForeground={color15}
